      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/api/v1/predict-batch",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({alumnos: $json.dataset.map(item => ({inscripcion_id: item.inscripcion_id, features: item.features}))}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
